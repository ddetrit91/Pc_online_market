# ========================================================
# PC ULTRA MARKET - ENVIRONMENT VARIABLES TEMPLATE
# Скопируйте этот файл в .env.local и укажите ваши значения
# ========================================================

# Neon PostgreSQL Connection Strings
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Neon Branch & Functions (optional, populated by `neon deploy`)
NEON_BRANCH="production"
NEON_BRANCH_ID="br-your-branch-id"
NEON_FUNCTION_HOST_SUFFIX=".compute.region.aws.neon.tech"

# Neon Object Storage (S3 compatible, populated by `neon deploy`)
AWS_ACCESS_KEY_ID="your-neon-s3-access-key"
AWS_SECRET_ACCESS_KEY="your-neon-s3-secret-key"
AWS_ENDPOINT_URL_S3="https://br-your-branch-id.storage.region.aws.neon.tech"
AWS_REGION="us-east-2"

# Публичный URL приложения
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Telegram Bot (отправка чеков и уведомлений о заказах менеджеру)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_BOT_USERNAME="your_bot_username"
TELEGRAM_CHAT_ID="123456789"

# Аутентификация и админ-панель
ADMIN_SECRET_KEY="replace-with-strong-random-secret"
AUTH_SECRET="replace-with-strong-jwt-hmac-secret"
ADMIN_EMAIL="admin@example.com"
ADMIN_INITIAL_PASSWORD="replace-with-strong-admin-password"

# Stripe Payments & Webhook (/api/stripe/checkout, /api/stripe/webhook)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_signing_secret"
STRIPE_CURRENCY="usd"
STRIPE_UZS_PER_USD="12800"
